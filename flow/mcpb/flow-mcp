#!/bin/sh
# MCPB bundle entry point: runs the Flow MCP server (stdio) off the jars staged beside it.
# Claude Desktop bundles a Node runtime but no JVM, so find one — JAVA_HOME first, then macOS's
# java_home, then PATH (which is minimal for a GUI-launched app, hence the two fallbacks above).
DIR=$(cd "$(dirname "$0")" && pwd)

JAVA=""
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA="$JAVA_HOME/bin/java"
elif [ -x /usr/libexec/java_home ]; then
    JH=$(/usr/libexec/java_home -v 17+ 2>/dev/null)
    [ -n "$JH" ] && [ -x "$JH/bin/java" ] && JAVA="$JH/bin/java"
fi
[ -n "$JAVA" ] || JAVA=$(command -v java 2>/dev/null)

if [ -z "$JAVA" ]; then
    echo "flow-mcp: no Java 17+ runtime found — install a JDK 17+ or set JAVA_HOME." >&2
    exit 1
fi

# same contract as :flow:mcpLauncher — built-in module jars come from the resources dir
# headless and with no dock icon: this talks over a pipe and has no business on the screen
exec "$JAVA" -Dcompose.application.resources.dir="$DIR/resources" \
    -Djava.awt.headless=true -Dapple.awt.UIElement=true \
    -cp "$DIR/lib/*" flow.cli.CliKt --mcp "$@"
